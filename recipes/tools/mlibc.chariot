source/mlibc_headers {
    url: "https://github.com/Eucalyptus-OS/mlibc.git"
    type: "git"
    revision: "master"
}

source/mlibc {
    url: "https://github.com/Eucalyptus-OS/mlibc.git"
    type: "git"
    revision: "master"
}

package/mlibc_headers {
    dependencies: [
        source/mlibc_headers
        tool/pkgconf
        image/meson
        image/build-essential
    ]

    configure: <sh>
        meson setup \
            --cross-file $SOURCES_DIR/mlibc_headers/crossfile \
            --prefix=/usr \
            --buildtype=release \
            -Dheaders_only=true \
            $SOURCES_DIR/mlibc_headers
    </sh>

    build: <sh>
        ninja -j$PARALLELISM
    </sh>

    install: <sh>
        DESTDIR=$INSTALL_DIR ninja install
    </sh>
}

package/mlibc {
    dependencies: [
        source/mlibc
        tool/gcc_bootstrap
        tool/binutils
        package/mlibc_headers
        image/meson
        image/build-essential
    ]

    configure: <sh>
        meson setup \
            --cross-file $SOURCES_DIR/mlibc/crossfile \
            --prefix=/usr \
            --buildtype=release \
            $SOURCES_DIR/mlibc
    </sh>

    build: <sh>
        ninja -j$PARALLELISM
    </sh>

    install: <sh>
        DESTDIR=$INSTALL_DIR ninja install
    </sh>
}
